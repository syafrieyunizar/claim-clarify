{
  "manifest_version": 3,
  "name": "Claim Clarify",
  "version": "1.0.5",
  "description": "Asisten side panel untuk menyusun draf jawaban pending klaim BPJS.",
  "permissions": ["sidePanel", "storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["file:///*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claim Clarify",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "mime_types_handler": {
    "application/pdf": {
      "handler_url": "src/pdf-handler/index.html"
    }
  },
  "optional_host_permissions": ["https://*/*", "http://*/*"]
}
